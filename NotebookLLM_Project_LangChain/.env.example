# Copy this file to .env and fill in OPENAI_API_KEY. Everything else is optional.
OPENAI_API_KEY=

# --- Answer model and its price (USD per 1M tokens). Check platform.openai.com/docs/pricing ---
OPENAI_MODEL=gpt-6-luna
PRICE_IN=0.10
PRICE_OUT=0.50

# --- Embeddings: openai (billed, $0.02 per 1M tokens for text-embedding-3-small) or local (free, BAAI bge) ---
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_PRICE_PER_M=0.02
# For free local embeddings instead: EMBED_PROVIDER=local and EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ---
RERANK_ENABLED=true
TOP_K=8

# --- Chunking (re-upload files after changing) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- OCR for scanned PDFs / images ---
OCR_ENABLED=true
OCR_LANG=eng

# Allowed upload types (comma separated).
ALLOWED_EXT=.pdf,.docx,.pptx,.xlsx,.csv,.md,.txt,.json,.png,.jpg,.jpeg

# Chunks before/after each hit that the model also reads (fixes explanations split across pages; 0 = off)
NEIGHBORS=1

# 3 clickable follow-up questions under each answer (costs one small extra call per answer; false = off)
SUGGESTIONS=true
